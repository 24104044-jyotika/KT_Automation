# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-here

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=MU Portal

# ── WhatsApp (Twilio) — optional ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=+14155238886

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_HOURS=6
MU_RESULT_BASE_URL=https://exam.mu.ac.in/ExamResult/frmResult.aspx
