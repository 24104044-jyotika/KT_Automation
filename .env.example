# ─── Copy this file to .env and fill in your values ───────────────────────────
# Then load it with: pip install python-dotenv
# And add at top of app.py: from dotenv import load_dotenv; load_dotenv()

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# 1. Go to myaccount.google.com → Security → 2-Step Verification → ON
# 2. Then go to: myaccount.google.com/apppasswords
# 3. Select "Mail" + "Windows Computer" → Generate → copy 16-char password

MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=MU Portal <your_gmail@gmail.com>

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
# 1. Sign up at https://www.twilio.com/try-twilio (free trial gives $15 credit)
# 2. Go to: console.twilio.com → Messaging → Try it out → Send a WhatsApp message
# 3. Copy Account SID and Auth Token from console.twilio.com

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=+14155238886

# ── Students must do this ONE TIME to receive WhatsApp messages ───────────────
# Open WhatsApp → New chat → +1 415 523 8886
# Send the message: join <sandbox-keyword>
# (Twilio gives you the exact keyword in the sandbox setup page)
